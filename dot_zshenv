# Read by zsh from $HOME before anything else. Session variables live in
# ~/.config/environment.d (single source of truth); systemd already exports
# them for graphical sessions, this loads them for shells it didn't start
# (SSH, TTY). Its KEY=value lines are valid shell assignments.
[[ -n "$ZDOTDIR" ]] || () {
  setopt local_options all_export
  local f
  for f in "$HOME"/.config/environment.d/*.conf(N); do source "$f"; done
}
