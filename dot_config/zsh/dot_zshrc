if [[ -n "$KITTY_INSTALLATION_DIR" ]]; then
    export KITTY_SHELL_INTEGRATION="enabled"
    autoload -Uz -- "$KITTY_INSTALLATION_DIR"/shell-integration/zsh/kitty-integration
    kitty-integration
    unfunction kitty-integration
fi


alias ls='eza --icons=always'
alias lg='lazygit'
alias scrcpy='scrcpy --render-driver=opengles2'
alias rf='rm -rf'
alias kp='killport'


# PATHS
BUN_BIN="$XDG_CACHE_HOME/.bun/bin"
export PNPM_HOME="$XDG_DATA_HOME/pnpm"
export GOPATH="$HOME/go"
export XDG_BIN_HOME="$HOME/.local/bin"
[ -d /usr/lib/jvm/java ] && export JAVA_HOME="/usr/lib/jvm/java"
export PATH="$PATH:$XDG_BIN_HOME:$GOPATH/bin:$PNPM_HOME:$PNPM_HOME/bin:$BUN_BIN:$JAVA_HOME"

# Android stuff
export ANDROID_HOME=$HOME/Android/Sdk
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/platform-tools

# Completion
autoload -U compinit && compinit
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
zstyle ':completion:*' menu select                   # tab cycles with highlighted selection
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS} # color file candidates like ls
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' # case-insensitive

# Plugins (declared in .chezmoiexternal.toml, installed by `chezmoi apply`)
ZSH_PLUGINS="$XDG_DATA_HOME/zsh/plugins"
# sourcing mode: zvm inits immediately so later keybinds (atuin, fsh) survive
ZVM_INIT_MODE=sourcing
source "$ZSH_PLUGINS/zsh-vi-mode/zsh-vi-mode.plugin.zsh"
source "$ZSH_PLUGINS/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"

# Lazy to configure prompt
for tool args in \
    starship 'init zsh' \
    atuin    'init zsh' \
    zoxide   'init zsh' \
    mise     'activate zsh' \
    direnv   'hook zsh'
do
    command -v $tool >/dev/null && eval "$($tool ${=args})"
done
unset tool args

