#!/usr/bin/env python3
# Take a screenshot through the xdg-desktop-portal (GNOME's native selection UI)
# and open it in satty. GNOME on Wayland doesn't allow grim-style capture tools.
import os
import subprocess
import sys
from urllib.parse import unquote, urlparse

from gi.repository import Gio, GLib

SATTY = os.path.expanduser("~/.local/share/mise/shims/satty")
OUTPUT_DIR = os.path.join(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES), "Screenshots")

bus = Gio.bus_get_sync(Gio.BusType.SESSION)
loop = GLib.MainLoop()
result = {}


def on_response(_conn, _sender, _path, _iface, _signal, params):
    code, results = params.unpack()
    if code == 0:
        result["uri"] = results["uri"]
    loop.quit()


# Subscribe before calling so the Response signal can't be missed.
sender = bus.get_unique_name()[1:].replace(".", "_")
token = f"satty{os.getpid()}"
bus.signal_subscribe(
    "org.freedesktop.portal.Desktop",
    "org.freedesktop.portal.Request",
    "Response",
    f"/org/freedesktop/portal/desktop/request/{sender}/{token}",
    None,
    Gio.DBusSignalFlags.NONE,
    on_response,
)
bus.call_sync(
    "org.freedesktop.portal.Desktop",
    "/org/freedesktop/portal/desktop",
    "org.freedesktop.portal.Screenshot",
    "Screenshot",
    GLib.Variant(
        "(sa{sv})",
        ("", {"handle_token": GLib.Variant("s", token), "interactive": GLib.Variant("b", True)}),
    ),
    None,
    Gio.DBusCallFlags.NONE,
    -1,
    None,
)
loop.run()

if "uri" not in result:
    sys.exit(1)  # cancelled

# The portal leaves a raw capture in ~/Pictures; hand it to satty on stdin and drop it.
path = unquote(urlparse(result["uri"]).path)
with open(path, "rb") as f:
    image = f.read()
os.remove(path)

os.makedirs(OUTPUT_DIR, exist_ok=True)
satty = subprocess.Popen(
    [
        SATTY,
        "--filename", "-",
        "--output-filename", os.path.join(OUTPUT_DIR, "Screenshot From %Y-%m-%d %H-%M-%S.png"),
        "--copy-command", "wl-copy",
        "--early-exit",
    ],
    stdin=subprocess.PIPE,
)
satty.communicate(image)
